@model GymMangment.BLL.ViewModels.PlanViewModels.UpdatePlanViewModel

<div class="container">
    <main role="main" class="pb-3">

        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card shadow-lg border-0">
                        <div class="card-header text-white text-center py-5 bg-primary-color">
                            <i class="bi bi-pencil-square display-4 mb-3"></i>
                            <h2 class="mb-0">Edit Plan</h2>
                        </div>
                        <div class="card-body p-4">

                            <form asp-action="Edit" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">
                                    <label asp-for="PlanName" class="form-label fw-bold">
                                        <i class="bi bi-award text-primary-color me-1"></i>Plan Name
                                    </label>
                                    <input asp-for="PlanName" class="form-control" />
                                    <span asp-validation-for="PlanName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label fw-bold">
                                        <i class="bi bi-file-text text-primary-color me-1"></i>Description
                                    </label>
                                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="DurationDays" class="form-label fw-bold">
                                        <i class="bi bi-calendar-check text-primary-color me-1"></i>Duration (days)
                                    </label>
                                    <input asp-for="DurationDays" type="number" class="form-control" />
                                    <span asp-validation-for="DurationDays" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Price" class="form-label fw-bold">
                                        <i class="bi bi-cash-coin text-primary-color me-1"></i>Price (EGP)
                                    </label>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>

                                <div class="d-flex justify-content-between gap-2">
                                    <a asp-action="Index" class="btn btn-outline flex-fill">
                                        <i class="bi bi-arrow-left me-1"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary-color flex-fill">
                                        <i class="bi bi-check-lg me-1"></i>Save Changes
                                    </button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}